# Nginx : port 80 → proxy vers Node (127.0.0.1:3000). TLS ajouté par certbot --nginx.
#
# 1) Copie + active :
#    sudo cp /opt/alps/server/nginx-alpine710.conf.example /etc/nginx/sites-available/alpine710.art
#    sudo ln -sf /etc/nginx/sites-available/alpine710.art /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
#
# 2) .env Node : PORT=3000 LISTEN_HOST=127.0.0.1 HTTP_REDIRECT_PORT=0 (sans NODE_SSL_*)
#    pm2 restart alps-web alps-bot
#
# 3) Certificat :
#    sudo certbot --nginx -d alpine710.art -d www.alpine710.art
#    (certbot modifie ce fichier pour ajouter HTTPS : plus de conflit avec Node sur le 80.)
#
# Après certbot, tu peux remplacer ce fichier par une version « finale » si besoin ;
# l’important est que Node ne bind **jamais** le port 80 en prod.

upstream alps_node {
    server 127.0.0.1:3000;
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name alpine710.art www.alpine710.art;

    client_max_body_size 55m;

    location / {
        proxy_pass http://alps_node;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
    }
}
