# --- Meta / Instagram (Graph API) ---
# Token Page / IG avec permissions Messagerie + lecture profil expéditeur (ex. instagram_manage_messages, instagram_basic… selon Meta).
# Sert à résoudre le @username à partir de l’IGSID dans les webhooks story_mention.
INSTAGRAM_ACCESS_TOKEN=

# Webhook verification (must match what you configure in Meta Developer console)
VERIFY_TOKEN=

# App Secret from the Meta app (Settings → Basic). Used to verify X-Hub-Signature-256 on POST /webhook.
# Leave empty only for local experiments (signatures will not be verified).
META_APP_SECRET=

# Graph version and host (defaults are usually fine for IG connected to a Facebook Page)
INSTAGRAM_GRAPH_VERSION=v21.0
INSTAGRAM_GRAPH_BASE=https://graph.facebook.com

# --- Telegram ---
TELEGRAM_TOKEN=
# Numeric user ID of the admin (get it via @userinfobot or similar)
TELEGRAM_ADMIN_ID=

# --- App ---
DATABASE_URL=sqlite+aiosqlite:///./contest.db

# Webhook rate limit (per client IP, in-memory — OK for single instance)
WEBHOOK_RATE_LIMIT_MAX=120
WEBHOOK_RATE_LIMIT_WINDOW_SECONDS=60

# Optional: default seed for /tirage when you omit the argument (integer or leave empty for non-deterministic)
# CONTEST_DEFAULT_RANDOM_SEED=12345

# Optional: enable /export (CSV) for admin
ENABLE_CSV_EXPORT_COMMAND=false

# BONUS flags (see README — dangerous / incomplete features)
INSTAGRAM_AUTO_FOLLOW_ENABLED=false
KEYWORD_DM_FILTER_ENABLED=false
